# Copy this file to .env and fill in your values
# .env is gitignored — NEVER commit it
# AWS credentials are handled via AWS_PROFILE in ~/.zshrc
# No access keys needed here

# ── AWS config
AWS_REGION=us-east-1

# ── Bedrock config
BEDROCK_MODEL_ID=anthropic.claude-haiku-4-5-20251001

# ── S3 config (filled after terraform apply)
S3_BUCKET_NAME=your-bucket-name-here

# ── API Gateway (filled after terraform apply)
API_GATEWAY_URL=https://your-api-id.execute-api.us-east-1.amazonaws.com/dev/summarize
